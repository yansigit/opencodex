{
  "manifest_version": 3,
  "name": "OpenCodex AI Studio Relay",
  "version": "1.0.0",
  "description": "Background relay for Google AI Studio Web session with opencodex",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://aistudio.google.com/*",
    "https://*.clients6.google.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenCodex AI Studio Relay"
  }
}
