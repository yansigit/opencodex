{
  "manifest_version": 3,
  "name": "OpenCodex AI Studio Session Exporter",
  "version": "2.0.0",
  "description": "Export Google AI Studio session credentials to OpenCodex for direct inference",
  "permissions": [
    "tabs",
    "storage",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://aistudio.google.com/*",
    "https://*.google.com/*",
    "https://*.clients6.google.com/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenCodex AI Studio Exporter"
  }
}
