    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "20.11.13",
    "oxlint": "1.80.0",
    "react-refresh": "^0.18.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  },
