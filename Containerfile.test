FROM oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6

RUN apt-get update && apt-get install -y --no-install-recommends \
    adduser=3.152 \
    git=1:2.47.3-0+deb13u1 \
    jq=1.7.1-6+deb13u3 \
    nodejs=20.19.2+dfsg-1+deb13u2 \
    procps=2:4.0.4-9 \
    net-tools=2.10-1.3 \
    ca-certificates=20250419 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY gui/package.json gui/bun.lock ./gui/
RUN cd gui && bun install --frozen-lockfile
COPY integrations/replit-gateway/package.json integrations/replit-gateway/bun.lock ./integrations/replit-gateway/
RUN cd integrations/replit-gateway && bun install --frozen-lockfile

COPY . .
RUN test -z "$(find /app -path '*/node_modules' -prune -o -type f \( -name '*.pem' -o -name '*.key' -o -name '*.p12' -o -name '*.pfx' -o -name '*.jks' -o -name '*.sqlite' -o -name '*.sqlite3' -o -name '*.db' \) ! -path '/app/tests/fixtures/network-tls-test-cert.pem' ! -path '/app/tests/fixtures/network-tls-test-key.pem' -print -quit)"
RUN cd gui && bun run build
RUN rm -rf .git && git init -q && git add -A \
    && git -c user.name=container-test -c user.email=container-test@invalid commit -qm container-baseline \
    && test -z "$(git remote)"
RUN addgroup --system ocx && adduser --system --ingroup ocx --home /home/ocx ocx && chown -R ocx:ocx /app && chmod -R a-w /app

USER ocx
