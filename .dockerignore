**

!.dockerignore
!Dockerfile
!compose.yaml
!package.json
!bun.lock
!tsconfig.json

!src/
!src/**
# Prepared on the host with the canonical Git-tracked-source generator.
!src/generated/compatibility-version.json

!scripts/
scripts/**
!scripts/model-metadata.source.json

!docker/
docker/**
!docker/bootstrap-tls.ts
!docker/bootstrap-token.ts
!docker/config.json
!docker/healthcheck.ts
!docker/verify-compatibility.ts

!gui/
!gui/**
gui/node_modules/
gui/dist/
gui/.vite/

**/*.log

# Re-apply credential and state exclusions after the source allowlist above.
# Negation patterns can otherwise admit local files that Vite or a remote
# container builder would consume.
**/.git
**/.tmp
**/.worktrees
**/.codex
**/.opencode
**/.planning
**/.agents
**/.claude
**/.cursor
**/.windsurf
**/.ssh
**/.gnupg
**/.aws
**/.docker/config.json
**/.config/containers/auth.json
**/.config/gh/hosts.yml
**/.opencodex
**/.env
**/.env.*
**/.npmrc
**/.netrc
**/.pypirc
**/auth.json
**/credentials.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.sqlite
**/*.sqlite3
**/*.db
